# This file shows how to override database password securely
# DO NOT commit actual secrets.yaml to git!
# Instead, create secrets.yaml locally (not tracked) or use:
#   helm install dotent . -f values.yaml -f secrets.yaml
# Or use the --set flag:
#   helm install dotent . --set database.password="your-secure-password"

database:
  password: "change-me-to-strong-password"
  username: appuser
  dbname: appdb
